{
  "expo": {
    "name": "PoopTracker",
    "slug": "poop-tracker",
    "owner": "volaxxxx",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pooptracker",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.coupleapp.pooptracker",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pour enregistrer où tu étais quand tu as poop 💩",
        "NSLocationAlwaysUsageDescription": "Pour enregistrer où tu étais quand tu as poop 💩"
      }
    },
    "android": {
      "package": "com.coupleapp.pooptracker",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Pour enregistrer où tu étais quand tu as poop 💩"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
