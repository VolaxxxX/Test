{
  "expo": {
    "name": "PoopTracker",
    "slug": "poop-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pooptracker",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8E7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.coupleapp.pooptracker",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pour enregistrer où tu étais quand tu as poop 💩",
        "NSLocationAlwaysUsageDescription": "Pour enregistrer où tu étais quand tu as poop 💩"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF8E7"
      },
      "package": "com.coupleapp.pooptracker",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Pour enregistrer où tu étais quand tu as poop 💩"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
