{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["coupleCode"]
    },
    "activeSessions": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "history": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$coupleId": {
        ".indexOn": ["startTime", "date"]
      }
    },
    "messages": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$coupleId": {
        ".indexOn": ["timestamp"]
      }
    },
    "events": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
